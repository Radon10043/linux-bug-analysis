{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-command.sh\" 'push' 'git push'",
            "timeout": 10,
            "statusMessage": "Checking for git push"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-command.sh\" 'add' 'git add'",
            "timeout": 10,
            "statusMessage": "Checking for git add"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-command.sh\" 'commit' 'git commit'",
            "timeout": 10,
            "statusMessage": "Checking for git commit"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-command.sh\" 'send-email' 'git send-email'",
            "timeout": 10,
            "statusMessage": "Checking for git send-email"
          }
        ]
      }
    ]
  }
}
